{
  "name": "memory-map",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run design:tokens:check && tsc && vite build",
    "build:godot-web": "node scripts/build-godot-web.mjs",
    "design:tokens": "node scripts/export-design-tokens.mjs",
    "design:tokens:check": "node scripts/export-design-tokens.mjs --check",
    "export:godot": "vite-node scripts/export-godot-world-state.ts",
    "generate:pixel-island": "python3 scripts/pixel_island_pipeline.py",
    "generate:memory-room": "python3 scripts/pixel_island_pipeline.py --memory-room --validate",
    "test": "vitest",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "heic-to": "^1.4.2",
    "mapbox-gl": "^3.15.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "@types/mapbox-gl": "^3.4.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
