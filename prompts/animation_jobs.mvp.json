{
  "version": 1,
  "goal": "MVP animation scope for personalized Layer 3 worlds",
  "rules": {
    "character_motion": "Only player, AI employees, robots, and important NPCs need walk animations.",
    "static_world": "Buildings, islands, bridges, props, and UI do not walk.",
    "state_animation": "Buildings and environment assets receive unlock, upgrade, recovery, damp-fatigue, or ambient state animations.",
    "mvp_directions": "Generate down and right directions only. Left can be mirrored in Godot. Up is deferred until navigation needs it.",
    "excluded_action_types": "Run, jump, attack, block, die, climb, and swim are not part of the MVP because Memory Map is exploration and interaction, not an action RPG.",
    "first_frame": "Codex image2 generates animation-safe first frames with exact #00FF00 background.",
    "video": "Dreamina CLI image2video generates motion source video.",
    "postprocess": "tools/personal_asset_pipeline.py converts video into final_sprites and Godot manifest entries."
  },
  "animation_profiles": {
    "idle": {
      "frame_count": 8,
      "fps": 8,
      "loop": true,
      "directions": ["down", "right"],
      "prompt_template": "idle_breathing"
    },
    "walk": {
      "frame_count": 12,
      "fps": 12,
      "loop": true,
      "directions": ["down", "right"],
      "prompt_template": "walk_in_place"
    },
    "interact": {
      "frame_count": 10,
      "fps": 10,
      "loop": false,
      "directions": ["down", "right"],
      "prompt_template": "interact_point_tap"
    },
    "work": {
      "frame_count": 12,
      "fps": 10,
      "loop": true,
      "directions": ["down", "right"],
      "prompt_template": "work_typing_or_scanning"
    },
    "react": {
      "frame_count": 8,
      "fps": 10,
      "loop": false,
      "directions": ["down"],
      "prompt_template": "small_reaction"
    },
    "celebrate": {
      "frame_count": 10,
      "fps": 10,
      "loop": false,
      "directions": ["down"],
      "prompt_template": "task_complete_celebrate"
    }
  },
  "character_jobs": [
    {
      "asset_id": "player-founder",
      "source_asset": "public/assets/generated/v2/sprites/char-male.png",
      "animations": ["idle", "walk", "interact", "celebrate"],
      "priority": "p0",
      "semantic_use": "default player avatar"
    },
    {
      "asset_id": "ai-researcher",
      "source_asset": "public/assets/generated/v2/sprites/char-researcher.png",
      "animations": ["idle", "walk", "work", "react"],
      "priority": "p0",
      "semantic_use": "research and learning room NPC"
    },
    {
      "asset_id": "ai-analyst",
      "source_asset": "public/assets/generated/v2/sprites/char-analyst.png",
      "animations": ["idle", "walk", "work", "react"],
      "priority": "p0",
      "semantic_use": "finance and data analysis NPC"
    },
    {
      "asset_id": "ai-assistant",
      "source_asset": "public/assets/generated/v2/sprites/char-assistant.png",
      "animations": ["idle", "walk", "interact", "react"],
      "priority": "p0",
      "semantic_use": "task and schedule NPC"
    },
    {
      "asset_id": "ai-bot",
      "source_asset": "public/assets/generated/v2/sprites/char-bot.png",
      "animations": ["idle", "walk", "work", "react"],
      "priority": "p0",
      "semantic_use": "automation helper NPC"
    },
    {
      "asset_id": "alternate-avatar",
      "source_asset": "public/assets/generated/v2/sprites/char-female.png",
      "animations": ["idle", "walk", "interact"],
      "priority": "p1",
      "semantic_use": "alternate player avatar"
    }
  ],
