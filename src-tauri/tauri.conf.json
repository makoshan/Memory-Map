{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Memory Map",
  "version": "0.1.0",
  "identifier": "ai.memory-map.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Memory Map",
        "width": 1440,
        "height": 960,
        "minWidth": 1120,
        "minHeight": 760
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
